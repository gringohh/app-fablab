/**
 * Relais Drive — version Google Apps Script (sans Google Cloud Console).
 *
 * VERSION EN UN SEUL FICHIER : tout coller dans « Code.gs » sur script.google.com,
 * puis Déployer → Application Web. Voir LISEZMOI.md.
 * (Fichier généré à partir de Code.gs et Page.html : modifier ceux-là de préférence.)
 *
 * Le .zip est décompressé sur la tablette (dans la page), puis chaque fichier
 * est envoyé ici et rangé dans : Mon Drive / Relais tablette / <nom du zip> / …
 */

// Nom du dossier principal créé à la racine du Drive
const RACINE = 'Relais tablette';

// Taille maximale d'un fichier (limite d'Apps Script : 50 Mo)
const TAILLE_MAX = 40 * 1024 * 1024;

function doGet() {
  return HtmlService.createHtmlOutput(PAGE)
    .setTitle('Relais Drive')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function dossierRacine_() {
  const racineDrive = DriveApp.getRootFolder();
  const it = racineDrive.getFoldersByName(RACINE);
  return it.hasNext() ? it.next() : racineDrive.createFolder(RACINE);
}

function sousDossier_(parent, nom) {
  const it = parent.getFoldersByName(nom);
  return it.hasNext() ? it.next() : parent.createFolder(nom);
}

/**
 * Crée le dossier d'un lot (sans écraser : « nom (2) » si besoin)
 * et tous ses sous-dossiers. Renvoie les identifiants pour l'envoi des fichiers.
 * @param {string} nom      nom souhaité du dossier
 * @param {string[]} chemins sous-dossiers, par ex. ["plans", "plans/vues"]
 */
function preparerLot(nom, chemins) {
  const racine = dossierRacine_();
  nom = String(nom || '').replace(/[\/\\]/g, '-').trim() || 'Envoi';
  let final = nom;
  for (let i = 2; racine.getFoldersByName(final).hasNext(); i++) final = nom + ' (' + i + ')';
  const dossier = racine.createFolder(final);

  const objets = { '': dossier };
  const ids = { '': dossier.getId() };
  // Du moins profond au plus profond, pour que le parent existe toujours
  const tries = (chemins || []).filter(String).sort(function (a, b) {
    return a.split('/').length - b.split('/').length;
  });
  tries.forEach(function (c) {
    if (objets[c]) return;
    const parties = c.split('/');
    const nomSous = parties.pop();
    const parent = objets[parties.join('/')] || dossier;
    objets[c] = sousDossier_(parent, nomSous);
    ids[c] = objets[c].getId();
  });
  return { url: dossier.getUrl(), nom: final, racine: RACINE, dossiers: ids };
}

/**
 * Enregistre un fichier dans un dossier.
 * @param {string} dossierId identifiant renvoyé par preparerLot
 * @param {string} nom       nom du fichier
 * @param {string} type      type MIME (peut être vide)
 * @param {string} base64    contenu encodé en base64
 */
function envoyerFichier(dossierId, nom, type, base64) {
  const octets = Utilities.base64Decode(base64);
  if (octets.length > TAILLE_MAX) throw new Error('Fichier trop gros (40 Mo maximum)');
  const blob = Utilities.newBlob(octets, type || 'application/octet-stream', nom);
  DriveApp.getFolderById(dossierId).createFile(blob);
  return true;
}

// Contenu de la page (Page.html)
const PAGE = "<!doctype html>\n<html lang=\"fr\">\n<head>\n<base target=\"_top\">\n<meta charset=\"utf-8\">\n<style>\n:root {\n  --fond: #f3f5f9; --carte: #ffffff; --texte: #1b2433; --doux: #5b6678; --bord: #dde2ea;\n  --bleu: #1d5fc4; --bleu-clair: #e7effb; --vert: #1e8e4f; --vert-clair: #e5f5ec;\n  --rouge: #c0392b; --rouge-clair: #fbeae8; --orange: #b86e00;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --fond: #11161f; --carte: #1a212d; --texte: #e6eaf1; --doux: #9aa5b8; --bord: #2c3646;\n    --bleu: #5b9bff; --bleu-clair: #1d2a40; --vert: #4cc283; --vert-clair: #16301f;\n    --rouge: #ff7a6b; --rouge-clair: #3a1d1a; --orange: #f0a64a;\n  }\n}\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--fond); color: var(--texte);\n  font: 17px/1.45 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\nheader { background: var(--bleu); color: #fff; padding: 14px 16px; }\nheader h1 { font-size: 21px; margin: 0; }\nmain { max-width: 760px; margin: 0 auto; padding: 16px; padding-bottom: 60px; }\n.carte { background: var(--carte); border: 1px solid var(--bord); border-radius: 14px; padding: 16px; margin-bottom: 14px; }\nh2 { font-size: 18px; margin: 0 0 10px; }\np { margin: 6px 0; }\n.doux { color: var(--doux); font-size: 15px; }\nbutton, .bouton { font: inherit; border-radius: 10px; border: 1px solid var(--bord); background: var(--carte);\n  color: var(--texte); padding: 12px 16px; cursor: pointer; min-height: 48px; text-decoration: none;\n  display: inline-flex; align-items: center; justify-content: center; gap: 8px; }\nbutton.principal { background: var(--bleu); border-color: var(--bleu); color: #fff; font-weight: 600; }\nbutton:disabled { opacity: .5; cursor: default; }\nbutton.petit { min-height: 38px; padding: 6px 12px; font-size: 15px; }\n.rangee { display: flex; gap: 10px; flex-wrap: wrap; }\n.rangee > * { flex: 1 1 200px; }\n.depot { border: 2px dashed var(--bleu); background: var(--bleu-clair); border-radius: 14px; padding: 22px 16px; text-align: center; }\n.depot strong { display: block; font-size: 19px; margin-bottom: 4px; }\ninput[type=text], textarea { font: inherit; width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--bord);\n  background: var(--fond); color: var(--texte); min-height: 46px; }\n.lot { border: 1px solid var(--bord); border-radius: 12px; padding: 12px; margin-top: 10px; }\n.lot .entete { display: flex; gap: 10px; align-items: center; }\n.lot .entete input { flex: 1; }\n.lot details { margin-top: 8px; }\n.lot summary { cursor: pointer; color: var(--doux); font-size: 15px; }\n.lot ul { margin: 6px 0 0; padding-left: 18px; max-height: 240px; overflow: auto; font-size: 14px; word-break: break-all; }\n.etat { font-size: 14px; margin-top: 8px; }\n.erreur { color: var(--rouge); } .attention { color: var(--orange); }\n.barre { height: 12px; background: var(--bord); border-radius: 999px; overflow: hidden; margin: 10px 0 6px; }\n.barre > div { height: 100%; width: 0; background: var(--bleu); transition: width .2s; }\n.resultat { background: var(--vert-clair); border-radius: 12px; padding: 12px; margin-top: 10px; }\n.resultat.echec { background: var(--rouge-clair); }\n.resultat .rangee { margin-top: 8px; }\n.resultat textarea { margin-top: 8px; font-size: 14px; min-height: 0; }\n.historique li { margin-bottom: 6px; }\n.historique a { color: var(--bleu); }\n.cache { display: none !important; }\n</style>\n</head>\n<body>\n<header><h1>☁️ Relais Drive</h1></header>\n<main>\n  <section class=\"carte\">\n    <div class=\"depot\">\n      <strong>Choisis un ou plusieurs fichiers .zip</strong>\n      <span class=\"doux\">Ils sont décompressés ici, sans rien mélanger dans Téléchargements.</span>\n      <div class=\"rangee\" style=\"margin-top:14px\">\n        <button class=\"principal\" id=\"btnChoisirZip\" type=\"button\">📦 Choisir des .zip</button>\n        <button id=\"btnChoisirFichiers\" type=\"button\">📄 Autres fichiers</button>\n      </div>\n    </div>\n    <input type=\"file\" id=\"entreeZip\" accept=\".zip,application/zip,application/x-zip-compressed\" multiple class=\"cache\">\n    <input type=\"file\" id=\"entreeFichiers\" multiple class=\"cache\">\n  </section>\n\n  <section class=\"carte cache\" id=\"sectionLots\">\n    <h2>À envoyer</h2>\n    <p class=\"doux\">Chaque lot devient un dossier dans « Relais tablette » sur ton Drive. Tu peux renommer le dossier.</p>\n    <div id=\"listeLots\"></div>\n    <div class=\"barre cache\" id=\"barre\"><div></div></div>\n    <p class=\"doux cache\" id=\"texteProgres\"></p>\n    <div class=\"rangee\" style=\"margin-top:14px\">\n      <button class=\"principal\" id=\"btnEnvoyer\" type=\"button\">☁️ Envoyer sur le Drive</button>\n      <button id=\"btnVider\" type=\"button\">Tout retirer</button>\n    </div>\n  </section>\n\n  <section class=\"carte cache\" id=\"sectionResultats\">\n    <h2>Envoyé</h2>\n    <div id=\"listeResultats\"></div>\n  </section>\n\n  <section class=\"carte cache\" id=\"sectionHistorique\">\n    <h2>Derniers envois</h2>\n    <ul class=\"historique\" id=\"listeHistorique\"></ul>\n  </section>\n</main>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js\"></script>\n<script>\n'use strict';\nconst ENVOIS_SIMULTANES = 3;\nconst TAILLE_MAX = 40 * 1024 * 1024;\nconst IGNORES = /(^|\\/)(__MACOSX\\/|\\.DS_Store$|Thumbs\\.db$|desktop\\.ini$)/i;\n\nconst $ = id => document.getElementById(id);\nconst pause = ms => new Promise(r => setTimeout(r, ms));\nfunction echapper(t) { return String(t).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c])); }\nfunction taille(o) {\n  if (!o) return '—';\n  const u = ['o', 'Ko', 'Mo', 'Go']; let i = 0;\n  while (o >= 1024 && i < u.length - 1) { o /= 1024; i++; }\n  return (i ? o.toFixed(o < 10 ? 1 : 0) : o) + ' ' + u[i];\n}\nconst stock = {\n  lire(cle, defaut) { try { const v = localStorage.getItem('relais.' + cle); return v === null ? defaut : JSON.parse(v); } catch (e) { return defaut; } },\n  ecrire(cle, val) { try { localStorage.setItem('relais.' + cle, JSON.stringify(val)); } catch (e) {} }\n};\n\n// Appel d'une fonction de Code.gs, sous forme de promesse\nfunction serveur(fonction, ...args) {\n  return new Promise((ok, ko) => google.script.run.withSuccessHandler(ok).withFailureHandler(ko)[fonction](...args));\n}\nasync function serveurAvecEssais(fonction, ...args) {\n  for (let n = 0; ; n++) {\n    try { return await serveur(fonction, ...args); }\n    catch (e) { if (n >= 3 || /trop gros/i.test(e.message)) throw e; await pause(1500 * 2 ** n); }\n  }\n}\nfunction enBase64(blob) {\n  return new Promise((ok, ko) => {\n    const r = new FileReader();\n    r.onload = () => ok(r.result.slice(r.result.indexOf(',') + 1));\n    r.onerror = () => ko(r.error);\n    r.readAsDataURL(blob);\n  });\n}\n\n/* ---------- Lots : un lot = un dossier sur le Drive ---------- */\nlet lots = [], envoiEnCours = false, compteur = 0;\nfunction nomDuJour() {\n  const d = new Date(), z = n => String(n).padStart(2, '0');\n  return `Envoi du ${z(d.getDate())}-${z(d.getMonth() + 1)}-${d.getFullYear()} ${z(d.getHours())}h${z(d.getMinutes())}`;\n}\n\nasync function ajouterFichiers(liste) {\n  const zips = [], autres = [];\n  for (const f of liste) (/\\.zip$/i.test(f.name) || /zip/.test(f.type) ? zips : autres).push(f);\n  for (const f of zips) {\n    const lot = { id: ++compteur, nom: f.name.replace(/\\.zip$/i, '') || f.name, source: f.name, entrees: [], etat: 'lecture' };\n    lots.push(lot); afficherLots();\n    try {\n      if (!window.JSZip) throw new Error('module de décompression non chargé (réseau ?)');\n      const zip = await JSZip.loadAsync(f);\n      zip.forEach((chemin, e) => {\n        if (e.dir || IGNORES.test(chemin)) return;\n        lot.entrees.push({ chemin, taille: (e._data && e._data.uncompressedSize) || 0, blob: () => e.async('blob') });\n      });\n      // Un seul dossier dans le zip : on ne le répète pas (« Projet/… » et non « Projet/Projet/… »)\n      const premiers = new Set(lot.entrees.map(x => x.chemin.split('/')[0]));\n      if (premiers.size === 1 && lot.entrees.every(x => x.chemin.includes('/'))) {\n        const [unique] = premiers;\n        if (unique) { lot.nom = unique; lot.entrees.forEach(x => x.chemin = x.chemin.slice(unique.length + 1)); }\n      }\n      lot.etat = lot.entrees.length ? 'pret' : 'vide';\n    } catch (e) { lot.etat = 'erreur'; lot.message = 'Lecture du zip impossible : ' + e.message; }\n    afficherLots();\n  }\n  if (autres.length) {\n    lots.push({ id: ++compteur, nom: nomDuJour(), source: autres.length + ' fichier(s)', etat: 'pret',\n      entrees: autres.map(f => ({ chemin: f.name, taille: f.size, blob: async () => f })) });\n    afficherLots();\n  }\n}\n\nfunction afficherLots() {\n  $('sectionLots').classList.toggle('cache', !lots.length);\n  $('listeLots').innerHTML = lots.map(l => {\n    const total = l.entrees.reduce((s, e) => s + e.taille, 0);\n    const gros = l.entrees.filter(e => e.taille > TAILLE_MAX).length;\n    let etat;\n    if (l.etat === 'lecture') etat = '<span class=\"doux\">Lecture du zip…</span>';\n    else if (l.etat === 'vide') etat = '<span class=\"attention\">Ce zip ne contient aucun fichier.</span>';\n    else if (l.etat === 'erreur') etat = `<span class=\"erreur\">${echapper(l.message)}</span>`;\n    else if (l.etat === 'envoi') etat = `<span class=\"doux\">Envoi : ${l.faits || 0} / ${(l.echecs || l.entrees).length}</span>`;\n    else etat = `<span class=\"doux\">${l.entrees.length} fichier(s) · ${taille(total)}</span>`;\n    if (l.echecs && l.etat !== 'envoi') etat += ` · <span class=\"erreur\">${l.echecs.length} à renvoyer</span>`;\n    if (gros) etat += ` · <span class=\"attention\">${gros} fichier(s) de plus de 40 Mo ne passeront pas</span>`;\n    const apercu = l.entrees.slice(0, 300).map(e => `<li>${echapper(e.chemin)} <span class=\"doux\">(${taille(e.taille)})</span></li>`).join('')\n      + (l.entrees.length > 300 ? `<li class=\"doux\">… et ${l.entrees.length - 300} autres</li>` : '');\n    return `<div class=\"lot\" data-id=\"${l.id}\">\n      <div class=\"entete\">\n        <input type=\"text\" value=\"${echapper(l.nom)}\" aria-label=\"Nom du dossier\" data-champ=\"nom\" ${envoiEnCours || l.dossiers ? 'disabled' : ''}>\n        <button class=\"petit\" data-retirer=\"${l.id}\" type=\"button\" ${envoiEnCours ? 'disabled' : ''} aria-label=\"Retirer\">✕</button>\n      </div>\n      <div class=\"etat\">📦 ${echapper(l.source)} — ${etat}</div>\n      ${l.entrees.length ? `<details><summary>Voir les fichiers</summary><ul>${apercu}</ul></details>` : ''}\n    </div>`;\n  }).join('');\n  $('btnEnvoyer').disabled = envoiEnCours || !lots.some(l => l.etat === 'pret');\n  $('btnVider').disabled = envoiEnCours;\n}\n$('listeLots').addEventListener('input', e => {\n  if (e.target.dataset.champ !== 'nom') return;\n  const lot = lots.find(l => l.id == e.target.closest('.lot').dataset.id);\n  if (lot) lot.nom = e.target.value;\n});\n$('listeLots').addEventListener('click', e => {\n  const id = e.target.dataset && e.target.dataset.retirer;\n  if (id) { lots = lots.filter(l => l.id != id); afficherLots(); }\n});\n\n/* ---------- Envoi ---------- */\nasync function envoyerTout() {\n  if (envoiEnCours) return;\n  const aEnvoyer = lots.filter(l => l.etat === 'pret');\n  if (!aEnvoyer.length) return;\n  envoiEnCours = true; afficherLots();\n  const total = aEnvoyer.reduce((s, l) => s + (l.echecs || l.entrees).length, 0);\n  let faits = 0;\n  $('barre').classList.remove('cache'); $('texteProgres').classList.remove('cache');\n  const progres = t => { $('barre').firstElementChild.style.width = (total ? 100 * faits / total : 0) + '%'; $('texteProgres').textContent = t; };\n\n  try {\n    for (const lot of aEnvoyer) {\n      const liste = lot.echecs || lot.entrees;\n      lot.etat = 'envoi'; lot.faits = 0; afficherLots();\n      if (!lot.dossiers) {\n        progres(`Création du dossier « ${lot.nom} »…`);\n        const chemins = [...new Set(lot.entrees.flatMap(e => {\n          const p = e.chemin.split('/').slice(0, -1);\n          return p.map((_, i) => p.slice(0, i + 1).join('/'));\n        }))];\n        const r = await serveurAvecEssais('preparerLot', lot.nom, chemins);\n        Object.assign(lot, { dossiers: r.dossiers, lien: r.url, nomFinal: r.nom, racine: r.racine });\n      }\n      const file = liste.slice(), echecs = [];\n      const travailleur = async () => {\n        while (file.length) {\n          const e = file.shift();\n          const morceaux = e.chemin.split('/'); const nom = morceaux.pop();\n          progres(`${lot.nomFinal} : ${nom}`);\n          try {\n            if (e.taille > TAILLE_MAX) throw new Error('Fichier trop gros (40 Mo maximum)');\n            const blob = await e.blob();\n            await serveurAvecEssais('envoyerFichier', lot.dossiers[morceaux.join('/')], nom, blob.type || '', await enBase64(blob));\n          } catch (err) { e.erreur = err.message || String(err); echecs.push(e); }\n          lot.faits++; faits++;\n          const el = document.querySelector(`.lot[data-id=\"${lot.id}\"] .etat`);\n          if (el) el.innerHTML = `📦 ${echapper(lot.source)} — <span class=\"doux\">Envoi : ${lot.faits} / ${liste.length}</span>`;\n        }\n      };\n      await Promise.all(Array.from({ length: ENVOIS_SIMULTANES }, travailleur));\n      if (echecs.length) { lot.echecs = echecs; lot.etat = 'pret'; }\n      else { lot.etat = 'fini'; delete lot.echecs; ajouterHistorique(lot); }\n      afficherResultat(lot, echecs);\n    }\n    progres('Terminé.');\n  } catch (e) {\n    progres('Arrêt : ' + (e.message || e));\n    aEnvoyer.forEach(l => { if (l.etat === 'envoi') l.etat = 'pret'; });\n  } finally {\n    envoiEnCours = false;\n    lots = lots.filter(l => l.etat !== 'fini');\n    afficherLots();\n  }\n}\n\nfunction phrase(racine, nom, lien) { return `Regarde le dossier « ${racine}/${nom} » dans mon Google Drive : ${lien}`; }\nfunction afficherResultat(lot, echecs) {\n  $('sectionResultats').classList.remove('cache');\n  const div = document.createElement('div');\n  div.className = 'resultat' + (echecs.length ? ' echec' : '');\n  div.innerHTML = echecs.length\n    ? `<strong>⚠️ ${echapper(lot.nomFinal)}</strong> — ${echecs.length} fichier(s) non envoyé(s). Appuie à nouveau sur « Envoyer » pour réessayer uniquement ceux-là.\n       <ul class=\"doux\">${echecs.slice(0, 10).map(e => `<li>${echapper(e.chemin)} : ${echapper(e.erreur)}</li>`).join('')}</ul>`\n    : `<strong>✅ ${echapper(lot.nomFinal)}</strong> — ${lot.entrees.length} fichier(s) dans « ${echapper(lot.racine)} ».`;\n  div.appendChild(boutons(phrase(lot.racine, lot.nomFinal, lot.lien), lot.lien));\n  $('listeResultats').prepend(div);\n}\nfunction boutons(texte, lien) {\n  const bloc = document.createElement('div');\n  bloc.innerHTML = `<div class=\"rangee\"><a class=\"bouton\" href=\"${echapper(lien)}\" target=\"_blank\" rel=\"noopener\">Ouvrir dans Drive</a>\n    <button type=\"button\" class=\"principal\">📋 Copier la phrase pour Claude</button></div>\n    <textarea readonly rows=\"2\" class=\"cache\"></textarea>`;\n  const zone = bloc.querySelector('textarea'); zone.value = texte;\n  bloc.querySelector('button').onclick = async e => {\n    try { await navigator.clipboard.writeText(texte); e.target.textContent = '✓ Copié ! Colle-le dans Claude'; }\n    catch (err) {\n      // Presse-papiers bloqué : on affiche le texte sélectionné pour un « Copier » manuel\n      zone.classList.remove('cache'); zone.focus(); zone.select();\n      try { document.execCommand('copy'); e.target.textContent = '✓ Copié ! Colle-le dans Claude'; } catch (x) {}\n    }\n  };\n  return bloc;\n}\n\n/* ---------- Historique ---------- */\nfunction ajouterHistorique(lot) {\n  const h = stock.lire('historique', []);\n  h.unshift({ nom: lot.nomFinal, racine: lot.racine, lien: lot.lien, n: lot.entrees.length, date: Date.now() });\n  stock.ecrire('historique', h.slice(0, 15));\n  afficherHistorique();\n}\nfunction afficherHistorique() {\n  const h = stock.lire('historique', []);\n  $('sectionHistorique').classList.toggle('cache', !h.length);\n  $('listeHistorique').innerHTML = h.map(x => `<li><a href=\"${echapper(x.lien)}\" target=\"_blank\" rel=\"noopener\">${echapper(x.racine)}/${echapper(x.nom)}</a>\n    <span class=\"doux\">· ${x.n} fichier(s) · ${new Date(x.date).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}</span></li>`).join('');\n}\n\n/* ---------- Interface ---------- */\n$('btnChoisirZip').onclick = () => $('entreeZip').click();\n$('btnChoisirFichiers').onclick = () => $('entreeFichiers').click();\nfor (const id of ['entreeZip', 'entreeFichiers']) $(id).onchange = e => { ajouterFichiers([...e.target.files]); e.target.value = ''; };\n$('btnEnvoyer').onclick = envoyerTout;\n$('btnVider').onclick = () => { lots = []; afficherLots(); };\nwindow.addEventListener('beforeunload', e => { if (envoiEnCours) { e.preventDefault(); e.returnValue = ''; } });\nafficherHistorique(); afficherLots();\n</script>\n</body>\n</html>\n";
