{
  "name": "Relais Drive",
  "short_name": "Relais Drive",
  "description": "Décompresse un .zip sur la tablette et l'envoie, dossiers compris, dans Google Drive pour que Claude puisse le lire.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f5f9",
  "theme_color": "#1d5fc4",
  "icons": [
    { "src": "icones/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icones/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icones/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "fichiers", "accept": ["application/zip", "application/x-zip-compressed", ".zip", "*/*"] }
      ]
    }
  }
}
